/target
/.direnv
/.devenv
# nix build 产物 symlink (含连跑多次自动加 -N 后缀的 result-1/result-2..., 如 just nix-check)
/result*
*.swp
*.swo
.idea/
.vscode/

# 用户本地配置 (含可能的 secret 字段, 不应入库).
# 同时覆盖 default + 自定义命名 (避免用户改 config 文件名后 state 泄漏).
secret-guard.toml
secret-guard.state.toml
*.state.toml
*.state

# Playwright WebUI 测试产物 (node_modules 是 nix shellHook 创建的 symlink, 不入库;
# tests/ 子目录是 cwd=tests/webui 时 shellHook 相对路径再生的嵌套副本, 同因)
/tests/webui/node_modules/
/tests/webui/tests/
/tests/webui/test-results/
/tests/webui/playwright-report/

# Playwright MCP 工具的 a11y snapshot / console log 临时产物
/.playwright-mcp/
/.playwright-cli/

# cargo-llvm-cov 产物 (target/llvm-cov-target/ 已被 /target 覆盖).
/coverage/

# Task Master (任务规划/状态, agent 本地维护, 不入库)
.taskmaster/
.codegraph

